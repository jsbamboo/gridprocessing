@article{Prein2015,
   author = {Prein, A. F. and Langhans, W. and Fosser, G. and Ferrone, A. and Ban, N. and Goergen, K. and Keller, M. and Tolle, M. and Gutjahr, O. and Feser, F. and Brisson, E. and Kollet, S. and Schmidli, J. and van Lipzig, N. P. and Leung, R.},
   title = {A review on regional convection-permitting climate modeling: Demonstrations, prospects, and challenges},
   journal = {Rev Geophys},
   volume = {53},
   number = {2},
   pages = {323-361},
   note = {Prein, Andreas F
Langhans, Wolfgang
Fosser, Giorgia
Ferrone, Andrew
