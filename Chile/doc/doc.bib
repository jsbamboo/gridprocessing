@article{Vanos2023,
   author = {Vanos, J. and Guzman-Echavarria, G. and Baldwin, J. W. and Bongers, C. and Ebi, K. L. and Jay, O.},
   title = {A physiological approach for assessing human survivability and liveability to heat in a changing climate},
   journal = {Nat Commun},
   volume = {14},
   number = {1},
   pages = {7653},
   note = {Vanos, Jennifer
Guzman-Echavarria, Gisel
Baldwin, Jane W
Bongers, Coen
Ebi, Kristie L
Jay, Ollie
eng
CMMI-2045663/National Science Foundation (NSF)/
2021/GNT2009507/Department of Health | National Health and Medical Research Council (NHMRC)/
England
2023/11/30
Nat Commun. 2023 Nov 29;14(1):7653. doi: 10.1038/s41467-023-43121-5.},
   abstract = {Most studies projecting human survivability limits to extreme heat with climate change use a 35 degrees C wet-bulb temperature (T(w)) threshold without integrating variations in human physiology. This study applies physiological and biophysical principles for young and older adults, in sun or shade, to improve current estimates of survivability and introduce liveability (maximum safe, sustained activity) under current and future climates. Our physiology-based survival limits show a vast underestimation of risks by the 35 degrees C T(w) model in hot-dry conditions. Updated survivability limits correspond to T(w)~25.8-34.1 degrees C (young) and ~21.9-33.7 degrees C (old)-0.9-13.1 degrees C lower than T(w) = 35 degrees C. For older female adults, estimates are ~7.2-13.1 degrees C lower than 35 degrees C in dry conditions. Liveability declines with sun exposure and humidity, yet most dramatically with age (2.5-3.0 METs lower for older adults). Reductions in safe activity for younger and older adults between the present and future indicate a stronger impact from aging than warming.},
   keywords = {Humans
Female
Aged
*Hot Temperature
Temperature
*Extreme Heat
Humidity
Climate Change},
   ISSN = {2041-1723 (Electronic)
2041-1723 (Linking)},
   DOI = {10.1038/s41467-023-43121-5},
   url = {https://www.ncbi.nlm.nih.gov/pubmed/38030628},
   year = {2023},
   type = {Journal Article}
}

